# Tool digest/gate output — regenerated on demand, fingerprinted to git state.
cache/
settings.local.json

# A separate clone (git@github.com:Univers42/claude-code-best-practice.git) parked
# here for reference; it carries its own .git and 151 MB of assets.
claude-code-best-practice/

# Personal audio for the hook notifier — add your own, keep them local.
hooks/sounds/*/
!hooks/sounds/README.md

# Python bytecode from the hook handler.
__pycache__/
*.pyc

# Claude Code's runtime lock, written here when the kit is a host's .claude/
# submodule; untracked, it would mark that submodule dirty.
scheduled_tasks.lock
