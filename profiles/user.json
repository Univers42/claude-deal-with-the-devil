  "instructions": "profiles/claude-md.md",
  "settings": {
    "env": {
      "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
      "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
      "CLAUDE_MEM_ONLINE_OPTIN": "false",
      "DO_NOT_TRACK": "1",
      "CLAUDE_MEM_TELEMETRY": "off",
      "CLAUDE_MEM_TELEMETRY_ERRORS": "off"
    },
    "syncClaudeAiPlugins": false,
    "model": "opus",
    "effortLevel": "xhigh",
    "theme": "dark",
    "tui": "fullscreen",
    "agentPushNotifEnabled": true,
    "skipWorkflowUsageWarning": true,
    "modelSettings": {
      "claude-opus-5": {
        "effortLevel": "xhigh"
      },
      "claude-opus-5-5": {
        "effortLevel": "medium",
        "autoCompactWindow": 500000
      },
      "claude-haiku-5-5": {
        "effortLevel": "xhigh"
      }
    },
    "permissions": {
      "deny": [
        "Artifact",
        "RemoteTrigger"
      ]
    }
  },
  "remove_plugins": [
    "context7@claude-plugins-official",
    "figma@claude-plugins-official",
    "github@claude-plugins-official",
    "mongodb@claude-plugins-official",
    "fly@fly-skills",
    "product-management@knowledge-work-plugins",
    "engineering@knowledge-work-plugins",
    "design@knowledge-work-plugins",
    "data@knowledge-work-plugins",
    "operations@knowledge-work-plugins",
    "small-business@knowledge-work-plugins",
    "marketing@knowledge-work-plugins",
    "finance@knowledge-work-plugins",
    "legal@knowledge-work-plugins",
    "brand-voice@knowledge-work-plugins"
  ],
  "json_files": [
    {
      "pack": "memory",
      "path": "~/.claude-mem/settings.json",
      "merge": {
        "CLAUDE_MEM_FILE_READ_GATE_ENABLED": "false",
        "CLAUDE_MEM_PROVIDER": "claude",
        "CLAUDE_MEM_WORKER_HOST": "127.0.0.1",
        "CLAUDE_MEM_REDACT_ENABLED": "true",
        "CLAUDE_MEM_REDACT_GENERIC_ENABLED": "true"
      }
    },
    {
      "pack": "memory",
      "path": "~/.claude-mem/telemetry.json",
      "merge": {
        "enabled": false
      }
    }
  ],
  "commands": [
    {
      "pack": "memory",
      "name": "rtk-telemetry-off",
      "check": "rtk telemetry status 2>&1 | grep -qiE \"consent: +(declined|denied|refused|no)\"",
      "run": "rtk telemetry disable"
    },
    {
      "pack": "memory",
      "name": "rtk-hook",
      "check": "jq -e \"[.hooks.PreToolUse[]?.hooks[]?.command] | index(\\\"rtk hook claude\\\")\" ~/.claude/settings.json",
      "run": "rtk init -g --hook-only --auto-patch"
    },
    {
      "pack": "orchestrator",
      "name": "n8n-install",
      "check": "[ \"$($HOME/.local/share/harness42/n8n/node_modules/.bin/n8n --version 2>/dev/null)\" = 2.45.7 ]",
      "run": "install -d $HOME/.local/share/harness42/n8n && cp \"$HARNESS42_KIT\"/profiles/n8n/package.json \"$HARNESS42_KIT\"/profiles/n8n/package-lock.json $HOME/.local/share/harness42/n8n/ && cd $HOME/.local/share/harness42/n8n && npm ci --no-audit --no-fund --loglevel http"
    },
    {
      "pack": "orchestrator",
      "name": "n8n-service",
      "check": "cmp -s \"$HARNESS42_KIT\"/profiles/n8n/harness42-n8n.service $HOME/.config/systemd/user/harness42-n8n.service && systemctl --user is-active -q harness42-n8n",
      "run": "install -Dm644 \"$HARNESS42_KIT\"/profiles/n8n/harness42-n8n.service $HOME/.config/systemd/user/harness42-n8n.service && systemctl --user daemon-reload && systemctl --user enable -q harness42-n8n && systemctl --user restart harness42-n8n && sleep 20 && systemctl --user is-active -q harness42-n8n"
    },
    {
      "pack": "orchestrator",
      "name": "n8n-workflows",
      "check": "cmp -s \"$HARNESS42_KIT\"/profiles/n8n/workflows/ai-repo-brief.json $HOME/.local/share/harness42/n8n-data/imported/ai-repo-brief.json",
      "run": "N8N_USER_FOLDER=$HOME/.local/share/harness42/n8n-data $HOME/.local/share/harness42/n8n/node_modules/.bin/n8n import:workflow --input=\"$HARNESS42_KIT\"/profiles/n8n/workflows/ai-repo-brief.json && install -Dm644 \"$HARNESS42_KIT\"/profiles/n8n/workflows/ai-repo-brief.json $HOME/.local/share/harness42/n8n-data/imported/ai-repo-brief.json"
    },
    {
      "pack": "orchestrator",
      "name": "profile-check-timer",
      "check": "sed \"s#@KIT@#$HARNESS42_KIT#g\" \"$HARNESS42_KIT\"/profiles/n8n/harness42-profile-check.service | cmp -s - $HOME/.config/systemd/user/harness42-profile-check.service && systemctl --user is-enabled -q harness42-profile-check.timer",
      "run": "install -d $HOME/.config/systemd/user && sed \"s#@KIT@#$HARNESS42_KIT#g\" \"$HARNESS42_KIT\"/profiles/n8n/harness42-profile-check.service > $HOME/.config/systemd/user/harness42-profile-check.service && install -m644 \"$HARNESS42_KIT\"/profiles/n8n/harness42-profile-check.timer $HOME/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable -q --now harness42-profile-check.timer"
    },
    {
      "pack": "frontend",
      "name": "playwright-browser",
      "check": "test -x $HOME/.cache/ms-playwright/chromium_headless_shell-1247/chrome-headless-shell-linux64/chrome-headless-shell",
      "run": "npx -y playwright@1.64.0-alpha-1790635538000 install chromium-headless-shell"
    }
  ]
