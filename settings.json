    ],
    "FileChanged": [
      {
        "matcher": "\\.env|\\.envrc|\\.env\\.local|settings\\.json|\\.mcp\\.json",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/scripts/hooks.py",
